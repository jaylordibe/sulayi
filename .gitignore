# Build output.
# Anchored with a leading slash: a bare "sulayi" would also match the
# cmd/sulayi source directory and silently exclude the program's entrypoint.
/dist/
/bin/
/sulayi

# Assessment output (may contain evidence and redaction misses)
.sulayi/
*.sulayi-run/

# Local overrides
sulayi.local.yaml
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
